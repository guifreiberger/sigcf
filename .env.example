MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=sigcf
MYSQL_USER=sigcf
MYSQL_PASSWORD=sigcf
# 3307 no host para nao colidir com um MySQL instalado localmente na 3306
MYSQL_PORT=3307

# Usadas apenas pelo profile "app" (sistema completo em containers)
APP_PORT=8000
JWT_SECRET=troque-este-valor-antes-de-qualquer-deploy
JWT_EXPIRES_IN_SEGUNDOS=28800
SEED_SENHA=sigcf123

# Notificacoes push (Web Push/VAPID). Gere o par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@sigcf.com.br

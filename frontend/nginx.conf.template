server {
    # Porta alta: o nginx roda sem root e não pode abrir portas abaixo de 1024.
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    location /api/ {
        # Preenchido na subida do container: backend:3000 no Compose, localhost:3000 no Azure.
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        include /etc/nginx/seguranca.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Estes arquivos precisam ser revalidados para as atualizações chegarem aos celulares.
    location ~ ^/(sw\.js|registerSW\.js|index\.html)$ {
        include /etc/nginx/seguranca.conf;
        add_header Cache-Control "no-cache";
    }

    location = /manifest.webmanifest {
        default_type application/manifest+json;
        include /etc/nginx/seguranca.conf;
        add_header Cache-Control "no-cache";
    }

    # As respostas da /api já trazem os cabeçalhos do helmet; repeti-los aqui duplicaria valores.
    location / {
        include /etc/nginx/seguranca.conf;
        try_files $uri $uri/ /index.html;
    }
}

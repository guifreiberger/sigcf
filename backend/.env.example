NODE_ENV=development
PORT=3000

# O Nest roda fora do container nesta fase, entao o host e localhost.
# Se o backend passar a rodar dentro do compose, troque para DB_HOST=mysql e DB_PORT=3306.
DB_HOST=localhost
DB_PORT=3307
DB_USER=sigcf
DB_PASSWORD=sigcf
DB_NAME=sigcf

JWT_SECRET=troque-este-valor-antes-de-qualquer-deploy
JWT_EXPIRES_IN_SEGUNDOS=28800

# Senha dos usuarios de demonstracao criados por `npm run seed`
# (gestor@sigcf.local, joao@sigcf.local, maria@sigcf.local). Apenas desenvolvimento.
SEED_SENHA=sigcf123
